# Copy to .env for local runs. Never commit real secrets. Every service reads its own prefix.

# ---- case-core (TASLEEM_) ----
TASLEEM_DATABASE_URL=sqlite:///./tasleem.db
# TASLEEM_DATABASE_URL=postgresql+psycopg://user:password@host:5432/tasleem
# TASLEEM_REDIS_URL=redis://localhost:6379/0
# Demo mode: guest personas (X-Demo-User), demo scenarios, time travel, reset. Off by default.
TASLEEM_DEMO_MODE=true
TASLEEM_SEED_ON_START=true
TASLEEM_SCHEDULER_INTERVAL_SECONDS=0
# Outside demo mode these are required (the API refuses to start otherwise):
# TASLEEM_INTEGRATION_KEYS={"connector": "change-me", "notifier": "change-me-too"}
# TASLEEM_CORS_ORIGINS=["https://your-ui.example"]
# TASLEEM_AUTO_CREATE_SCHEMA=false   # run `python -m tasleem.migrate` instead
# TASLEEM_RATE_LIMIT_PER_SECOND=20
# TASLEEM_RATE_LIMIT_BURST=60

# ---- notifier (NOTIFIER_) ----
# NOTIFIER_DATABASE_URL=sqlite:///./notifier.db
# NOTIFIER_CORE_URL=http://localhost:8000
# NOTIFIER_CORE_INTEGRATION_KEY=change-me-too
# NOTIFIER_POLL_SECONDS=15
# NOTIFIER_PROVIDER=sandbox            # or webhook (needs NOTIFIER_WEBHOOKS and NOTIFIER_WEBHOOK_SECRET)
# NOTIFIER_WEBHOOKS={"sahatna_push": "https://bridge.example/sahatna", "sms_nudge": "https://bridge.example/sms"}
# NOTIFIER_WEBHOOK_SECRET=change-me
# NOTIFIER_OPS_KEY=change-me
# NOTIFIER_DEMO_MODE=true

# ---- agent (AGENT_) ----
# AGENT_CORE_URL=http://localhost:8000
# AGENT_DATABASE_URL=sqlite:///./agent.db
# AGENT_LLM_PROVIDER=offline           # offline | claude | groq | gemini | nvidia | openrouter | azure_openai | openai_compat
# AGENT_LLM_MODEL=                     # empty: provider default (Azure: the deployment name, e.g. gpt-5-mini)
# AGENT_LLM_BASE_URL=                  # openai_compat (any chat-completions host) or azure_openai
#                                      #   (https://<resource>.openai.azure.com/openai/v1)
# AGENT_LLM_REASONING_EFFORT=low       # gpt-5* / o* models only: minimal | low | medium | high
# AZURE_OPENAI_API_KEY=                # for azure_openai (on Azure it comes from Key Vault, never a file)
# AGENT_LLM_CACHE_ENTRIES=512         # same case state, same reply (one model call); 0 = off
# AGENT_LLM_COOLDOWN_SECONDS=60       # after a rate-limit reply, templates only for this long
# Put real keys in backend/.env (git- and docker-ignored), never in this file:
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# AGENT_LLM_API_KEY=                   # for openai_compat

# ---- HL7 connector (CONNECTOR_) ----
# CONNECTOR_CORE_URL=http://localhost:8000
# CONNECTOR_CORE_INTEGRATION_KEY=change-me
# CONNECTOR_INBOUND_KEY=change-me
# CONNECTOR_DEMO_MODE=true
